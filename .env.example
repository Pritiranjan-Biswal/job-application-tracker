# ==============================================================================
# Job Application Tracker - Environment Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/job_tracker_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_job_application_tracker_2026_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Cloudinary (Resume & Profile Picture Uploads)
# Note: In development, if Cloudinary credentials are not set, local disk storage fallback is used automatically.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer (Email Alerts & Reminders)
# Leave blank or use ethereal / smtp settings. If left blank, mock logger is used gracefully.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=JobTracker Support <noreply@jobtracker.app>

# Admin Seed Credentials (Used by: npm run seed:admin)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@jobtracker.com
ADMIN_PASSWORD=Admin@123456
